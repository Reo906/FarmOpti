# Required. Keep this value on the server.
ELEVENLABS_API_KEY=
FARMOPTI_CONSTRAINT_STORE_PATH=optimizer/runtime/confirmed_constraints.json

# Optional voice and model overrides.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
ELEVENLABS_TIMEOUT_SECONDS=60

# Comma-separated vocabulary sent as transcription keyterms.
FARMOPTI_VOICE_KEYTERMS=FarmOpti,F1,F2,harvest,harvester,irrigate,irrigation,spray,fertilise,fertiliser,plant,wheat,barley,canola,soil moisture,pest pressure

# Optional, only when the browser app and voice API use different origins.
FARMOPTI_VOICE_ALLOWED_ORIGINS=http://localhost:3000
