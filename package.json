{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "test": "tsx --test lib/optimizer/*.test.ts",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "optimizer:pipeline": "tsx lib/optimizer/pipeline.ts",
    "optimizer:chatbot": "tsx lib/optimizer/chatbot/chatbot.ts",
    "optimizer:server": "tsx lib/optimizer/server.ts",
    "optimizer:calibrate": "tsx lib/optimizer/calibration/cli.ts --history data/farm_history/history.csv --farm-id demo_farm --output data/farm_history",
    "optimizer:train-and-run": "tsx lib/optimizer/trainAndOptimize.ts data/farm_history/history.csv"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "highs": "^1.15.3",
    "input-otp": "1.4.2",
    "js-yaml": "^5.4.2",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
